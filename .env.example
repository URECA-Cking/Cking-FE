# 개발 서버(vite)가 /api 요청을 넘겨줄 실제 백엔드(Spring Boot, Cking-BE) 주소.
# 지정하지 않으면 http://localhost:8080 을 사용합니다.
VITE_API_PROXY_TARGET=http://localhost:8080

# API 요청의 기준 주소. 비워두면 현재 페이지와 같은 출처(/api/...)로 요청하며,
# 개발 서버의 프록시가 VITE_API_PROXY_TARGET 으로 전달합니다.
# 프록시 없이 배포된 백엔드를 직접 호출해야 할 때만 값을 채웁니다(백엔드 CORS 허용 필요).
VITE_API_BASE_URL=

# 백엔드에 크리에이터 목록 API가 없어, 이벤트가 하나도 없을 때 탐색 기준이 되는
# 크리에이터 ID 목록입니다. Cking-BE의 더미 시더는 크리에이터 1~3을 생성합니다.
VITE_DEMO_CREATOR_IDS=1,2,3
