{
  "name": "cking-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @cking/web",
    "dev:admin": "npm run dev --workspace @cking/admin",
    "build": "npm run build:web && npm run build:admin",
    "build:web": "npm run build --workspace @cking/web",
    "build:admin": "npm run build --workspace @cking/admin",
    "lint": "npm run lint:web && npm run lint:admin",
    "lint:web": "npm run lint --workspace @cking/web",
    "lint:admin": "npm run lint --workspace @cking/admin",
    "preview": "npm run preview --workspace @cking/web"
  }
}
